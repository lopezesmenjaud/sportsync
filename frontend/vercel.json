{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.fanschedule.com" }],
      "destination": "https://fanschedule.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/partido/:path*",
      "destination": "https://sportsync-awqq.onrender.com/partido/:path*" },
    { "source": "/equipo/:path*",
      "destination": "https://sportsync-awqq.onrender.com/equipo/:path*" },
    { "source": "/equipos",
      "destination": "https://sportsync-awqq.onrender.com/equipos" },
    { "source": "/sitemap.xml",
      "destination": "https://sportsync-awqq.onrender.com/sitemap.xml" },
    { "source": "/acerca",
      "destination": "https://sportsync-awqq.onrender.com/acerca" },
    { "source": "/contacto",
      "destination": "https://sportsync-awqq.onrender.com/contacto" },
    { "source": "/privacy",
      "destination": "https://sportsync-awqq.onrender.com/privacy" },
    { "source": "/terms",
      "destination": "https://sportsync-awqq.onrender.com/terms" },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
