{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.fanschedule.com" }],
      "destination": "https://fanschedule.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/partido/:path*",
      "destination": "https://sportsync-awqq.onrender.com/partido/:path*" },
    { "source": "/equipo/:path*",
      "destination": "https://sportsync-awqq.onrender.com/equipo/:path*" },
    { "source": "/sitemap.xml",
      "destination": "https://sportsync-awqq.onrender.com/sitemap.xml" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
