# Copia este archivo a .env y rellena los valores reales. NO comitees .env.

# ── Servidor ──
PORT=3000
NODE_ENV=development

# ── Frontend / OAuth ──
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── APIs externas ──
THE_SPORTS_DB_API_KEY=tu-thesportsdb-key
SPORTSDB_API_KEY=tu-thesportsdb-key
TICKETMASTER_API_KEY=tu-ticketmaster-key
ANTHROPIC_API_KEY=tu-anthropic-key
# Modelo de Anthropic (opcional; default: claude-sonnet-5). Cambiarlo evita tocar código.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Cifrado de tokens de Google en la DB (AES-256-GCM) ──
# Clave de 32 bytes en hexadecimal (64 caracteres). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: si esta clave se pierde o cambia, los tokens ya cifrados en la DB
# dejan de poder descifrarse y los usuarios afectados tendrán que reconectar Google.
TOKEN_ENCRYPTION_KEY=

# ── Ventana de migración de autorización ──
# Interruptor de la forma vieja (el userId que manda el cliente en la URL/body).
#   true  (o ausente) → se aceptan LAS DOS formas: sesión válida o userId del cliente.
#   false             → SOLO sesión. Todo lo viejo recibe 401.
# Se lee una sola vez al arrancar y se registra en el log de arranque.
# NO cerrarlo hasta que el frontend nuevo esté desplegado y verificado, y que
# auth_usage_daily muestre 0 peticiones con source='legacy' durante varios días:
#   node -e "const {db}=require('./src/db/database'); db.all('SELECT day,source,endpoint,count FROM auth_usage_daily ORDER BY day DESC, count DESC',[],(e,r)=>console.table(r))"
ALLOW_LEGACY_USERID=true
